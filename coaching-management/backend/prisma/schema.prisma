generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoleName {
  ADMIN
  HELPDESK
  RECEPTIONIST
  FOUNDING_MEMBER
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum CardStatus {
  ACTIVE
  INACTIVE
  REVOKED
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        RoleName @unique
  description String?  @db.Text
  users       User[]

  @@map("roles")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  username     String   @unique @db.VarChar(100)
  email        String?  @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(150)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  role         Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  students     Student[]            @relation("StudentCreator")
  courses      Course[]             @relation("CourseCreator")
  payments     Payment[]            @relation("ReceptionistPayments")
  approvals    PaymentApproval[]    @relation("FoundingMemberApprovals")
  approvalLogs PaymentApprovalLog[] @relation("ApprovalActor")
  auditLogs    AuditLog[]           @relation("UserAuditLogs")

  @@map("users")
}

model AcademicBatch {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(150)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  students    Student[]
  enrollments Enrollment[]

  @@map("academic_batches")
}

model Student {
  id              String        @id @default(uuid()) @db.Uuid
  academicBatchId String        @map("academic_batch_id") @db.Uuid
  fullName        String        @map("full_name") @db.VarChar(150)
  roll            String        @db.VarChar(50)
  phoneSelf       String        @map("phone_self") @db.VarChar(30)
  phoneGuardian   String?       @map("phone_guardian") @db.VarChar(30)
  bloodGroup      String?       @map("blood_group") @db.VarChar(10)
  schoolCollege   String        @map("school_college") @db.VarChar(150)
  photoUrl        String?       @map("photo_url") @db.Text
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  enrollments     Enrollment[]
  academicBatch   AcademicBatch @relation(fields: [academicBatchId], references: [id], onDelete: Restrict)
  creator         User          @relation("StudentCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  createdBy       String        @map("created_by") @db.Uuid

  @@unique([roll, academicBatchId], name: "roll_batch_unique")
  @@index([roll])
  @@map("students")
}

model CourseCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  courses     Course[]

  @@map("course_categories")
}

model Course {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(150)
  categoryId  String   @map("category_id") @db.Uuid
  fee         Decimal  @db.Decimal(10, 2)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  category    CourseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  creator     User           @relation("CourseCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  enrollments Enrollment[]

  @@map("courses")
}

model Enrollment {
  id              String           @id @default(uuid()) @db.Uuid
  studentId       String           @map("student_id") @db.Uuid
  courseId        String           @map("course_id") @db.Uuid
  academicBatchId String           @map("academic_batch_id") @db.Uuid
  agreedFee       Decimal          @map("agreed_fee") @db.Decimal(10, 2)
  status          EnrollmentStatus @default(ACTIVE)
  enrolledAt      DateTime         @default(now()) @map("enrolled_at") @db.Timestamp(6)

  student       Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course        Course        @relation(fields: [courseId], references: [id], onDelete: Restrict)
  academicBatch AcademicBatch @relation(fields: [academicBatchId], references: [id], onDelete: Restrict)
  payments      Payment[]
  paymentCards  PaymentCard[]

  @@unique([studentId, courseId], name: "student_course_unique")
  @@map("enrollments")
}

model Payment {
  id                   String               @id @default(uuid()) @db.Uuid
  verificationToken    String?              @unique @map("verification_token") @db.VarChar(100)
  billingPeriodStart   DateTime?            @map("billing_period_start") @db.Timestamp(6)
  billingPeriodEnd     DateTime?            @map("billing_period_end") @db.Timestamp(6)
  enrollmentId         String               @map("enrollment_id") @db.Uuid
  amountReceived       Decimal              @map("amount_received") @db.Decimal(10, 2)
  remainingBalance     Decimal              @map("remaining_balance") @db.Decimal(10, 2)
  transactionReference String?              @map("transaction_reference") @db.VarChar(100)
  paymentDate          DateTime             @default(now()) @map("payment_date") @db.Timestamp(6)
  status               PaymentStatus        @default(PENDING)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamp(6)
  enrollment           Enrollment           @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  approval             PaymentApproval?
  approvalLogs         PaymentApprovalLog[]
  receptionist         User                 @relation("ReceptionistPayments", fields: [receptionistId], references: [id], onDelete: Restrict)
  receptionistId       String               @map("receptionist_id") @db.Uuid

  @@index([status])
  @@map("payments")
}

model PaymentApproval {
  id              String        @id @default(uuid()) @db.Uuid
  paymentId       String        @unique @map("payment_id") @db.Uuid
  status          PaymentStatus
  rejectionReason String?       @map("rejection_reason") @db.Text
  reviewedAt      DateTime      @default(now()) @map("reviewed_at") @db.Timestamp(6)
  payment         Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  approvedBy      User          @relation("FoundingMemberApprovals", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedById    String        @map("founding_member_id") @db.Uuid

  @@map("payment_approvals")
}

model PaymentApprovalLog {
  id              String        @id @default(uuid()) @db.Uuid
  paymentId       String        @map("payment_id") @db.Uuid
  actorId         String        @map("actor_id") @db.Uuid
  action          String        @db.VarChar(50)
  previousStatus  PaymentStatus @map("previous_status")
  newStatus       PaymentStatus @map("new_status")
  rejectionReason String?       @map("rejection_reason") @db.Text
  comments        String?       @db.Text
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamp(6)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  actor   User    @relation("ApprovalActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@map("payment_approval_logs")
}

model PaymentCard {
  id           String     @id @default(uuid()) @db.Uuid
  enrollmentId String     @map("enrollment_id") @db.Uuid
  qrToken      String     @unique @map("qr_token") @db.VarChar(255)
  cardNumber   String     @unique @map("card_number") @db.VarChar(100)
  issuedAt     DateTime   @default(now()) @map("issued_at") @db.Timestamp(6)
  status       CardStatus @default(ACTIVE)

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  @@index([qrToken])
  @@map("payment_cards")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(100)
  module    String   @db.VarChar(100)
  details   Json?
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user User? @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@index([module])
  @@index([createdAt])
  @@map("audit_logs")
}
