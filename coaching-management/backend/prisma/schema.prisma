generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoleName {
  ADMIN
  HELPDESK
  RECEPTIONIST
  FOUNDING_MEMBER
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum CardStatus {
  ACTIVE
  INACTIVE
  REVOKED
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        RoleName @unique
  description String?  @db.Text

  @@map("roles")
}

model Student {
  id            String       @id @default(uuid()) @db.Uuid
  fullName      String       @map("full_name") @db.VarChar(150)
  roll          String       @unique @db.VarChar(50)
  phoneSelf     String       @map("phone_self") @db.VarChar(30)
  phoneGuardian String?      @map("phone_guardian") @db.VarChar(30)
  bloodGroup    String?      @map("blood_group") @db.VarChar(10)
  schoolCollege String       @map("school_college") @db.VarChar(150)
  photoUrl      String?      @map("photo_url") @db.Text
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  enrollments   Enrollment[]
  createdBy     String       @map("created_by") @db.Uuid

  @@index([roll])
  @@map("students")
}

model CourseCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  courses     Course[]

  @@map("course_categories")
}

model Course {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @unique @db.VarChar(150)
  categoryId  String         @map("category_id") @db.Uuid
  fee         Decimal        @db.Decimal(10, 2)
  description String?        @db.Text
  isActive    Boolean        @default(true) @map("is_active")
  createdBy   String         @map("created_by") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  category    CourseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  enrollments Enrollment[]

  @@map("courses")
}

model Enrollment {
  id           String           @id @default(uuid()) @db.Uuid
  studentId    String           @map("student_id") @db.Uuid
  courseId     String           @map("course_id") @db.Uuid
  agreedFee    Decimal          @map("agreed_fee") @db.Decimal(10, 2)
  status       EnrollmentStatus @default(ACTIVE)
  enrolledAt   DateTime         @default(now()) @map("enrolled_at") @db.Timestamp(6)
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course       Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  payments     Payment[]
  paymentCards PaymentCard[]

  @@unique([studentId, courseId], name: "student_course_unique")
  @@map("enrollments")
}

model Payment {
  id                   String               @id @default(uuid()) @db.Uuid
  verificationToken    String?              @unique @map("verification_token") @db.VarChar(100)
  billingPeriodStart   DateTime?            @map("billing_period_start") @db.Timestamp(6)
  billingPeriodEnd     DateTime?            @map("billing_period_end") @db.Timestamp(6)
  enrollmentId         String               @map("enrollment_id") @db.Uuid
  amountReceived       Decimal              @map("amount_received") @db.Decimal(10, 2)
  remainingBalance     Decimal              @map("remaining_balance") @db.Decimal(10, 2)
  transactionReference String?              @map("transaction_reference") @db.VarChar(100)
  paymentDate          DateTime             @default(now()) @map("payment_date") @db.Timestamp(6)
  status               PaymentStatus        @default(PENDING)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamp(6)
  enrollment           Enrollment           @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  approval             PaymentApproval?
  approvalLogs         PaymentApprovalLog[]

  @@index([status])
  @@map("payments")
}

model PaymentApproval {
  id              String        @id @default(uuid()) @db.Uuid
  paymentId       String        @unique @map("payment_id") @db.Uuid
  status          PaymentStatus
  rejectionReason String?       @map("rejection_reason") @db.Text
  reviewedAt      DateTime      @default(now()) @map("reviewed_at") @db.Timestamp(6)
  payment         Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  approvedBy      String        @map("approvedBy")

  @@map("payment_approvals")
}

model PaymentApprovalLog {
  id              String        @id @default(uuid()) @db.Uuid
  paymentId       String        @map("payment_id") @db.Uuid
  actorId         String        @map("actor_id") @db.Uuid
  action          String        @db.VarChar(50)
  previousStatus  PaymentStatus @map("previous_status")
  newStatus       PaymentStatus @map("new_status")
  rejectionReason String?       @map("rejection_reason") @db.Text
  comments        String?       @db.Text
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("payment_approval_logs")
}

model PaymentCard {
  id           String     @id @default(uuid()) @db.Uuid
  enrollmentId String     @map("enrollment_id") @db.Uuid
  qrToken      String     @unique @map("qr_token") @db.VarChar(255)
  cardNumber   String     @unique @map("card_number") @db.VarChar(100)
  issuedAt     DateTime   @default(now()) @map("issued_at") @db.Timestamp(6)
  status       CardStatus @default(ACTIVE)

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  @@index([qrToken])
  @@map("payment_cards")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(100)
  module    String   @db.VarChar(100)
  details   Json?
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([module])
  @@index([createdAt])
  @@map("audit_logs")
}
