generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  ADMIN
  HELPDESK
  RECEPTIONIST
  FOUNDING_MEMBER
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum CardStatus {
  ACTIVE
  INACTIVE
  REVOKED
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        RoleName @unique
  description String?  @db.Text
  users       User[]

  @@map("roles")
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  roleId        String    @db.Uuid @map("role_id")
  username      String    @unique @db.VarChar(100)
  email         String?   @unique @db.VarChar(255)
  passwordHash  String    @db.VarChar(255) @map("password_hash")
  fullName      String    @db.VarChar(150) @map("full_name")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  role          Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  students      Student[] @relation("StudentCreator")
  courses       Course[]  @relation("CourseCreator")
  payments      Payment[] @relation("ReceptionistPayments")
  approvals     PaymentApproval[] @relation("FoundingMemberApprovals")
  approvalLogs  PaymentApprovalLog[] @relation("ApprovalActor")
  auditLogs     AuditLog[] @relation("UserAuditLogs")

  @@map("users")
}

model AcademicBatch {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(150)
  institution String?      @db.VarChar(150)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamp(6)

  students    Student[]
  enrollments Enrollment[]

  @@map("academic_batches")
}

model Student {
  id              String        @id @default(uuid()) @db.Uuid
  tokenNumber     String        @unique @db.VarChar(50) @map("token_number")
  academicBatchId String        @db.Uuid @map("academic_batch_id")
  fullName        String        @db.VarChar(150) @map("full_name")
  roll            String        @db.VarChar(50)
  phoneSelf       String        @db.VarChar(30) @map("phone_self")
  phoneGuardian   String?       @db.VarChar(30) @map("phone_guardian")
  bloodGroup      String?       @db.VarChar(10) @map("blood_group")
  schoolCollege   String        @db.VarChar(150) @map("school_college")
  photoUrl        String?       @db.Text @map("photo_url")
  createdBy       String        @db.Uuid @map("created_by")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamp(6)

  academicBatch   AcademicBatch @relation(fields: [academicBatchId], references: [id], onDelete: Restrict)
  creator         User          @relation("StudentCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  enrollments     Enrollment[]

  @@unique([roll, academicBatchId], name: "roll_batch_unique")
  @@index([tokenNumber])
  @@map("students")
}

model CourseCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  courses     Course[]

  @@map("course_categories")
}

model Course {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @unique @db.VarChar(150)
  categoryId  String         @db.Uuid @map("category_id")
  fee         Decimal        @db.Decimal(10, 2)
  description String?        @db.Text
  isActive    Boolean        @default(true) @map("is_active")
  createdBy   String         @db.Uuid @map("created_by")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamp(6)

  category    CourseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  creator     User           @relation("CourseCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  enrollments Enrollment[]

  @@map("courses")
}

model Enrollment {
  id              String        @id @default(uuid()) @db.Uuid
  studentId       String        @db.Uuid @map("student_id")
  courseId        String        @db.Uuid @map("course_id")
  academicBatchId String        @db.Uuid @map("academic_batch_id")
  agreedFee       Decimal       @db.Decimal(10, 2) @map("agreed_fee")
  status          EnrollmentStatus @default(ACTIVE)
  enrolledAt      DateTime      @default(now()) @map("enrolled_at") @db.Timestamp(6)

  student         Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course          Course        @relation(fields: [courseId], references: [id], onDelete: Restrict)
  academicBatch   AcademicBatch @relation(fields: [academicBatchId], references: [id], onDelete: Restrict)
  payments        Payment[]
  paymentCards    PaymentCard[]

  @@unique([studentId, courseId], name: "student_course_unique")
  @@map("enrollments")
}

model Payment {
  id                   String               @id @default(uuid()) @db.Uuid
  paymentReference     String               @unique @db.VarChar(100) @map("payment_reference")
  enrollmentId         String               @db.Uuid @map("enrollment_id")
  amountReceived       Decimal              @db.Decimal(10, 2) @map("amount_received")
  remainingBalance     Decimal              @db.Decimal(10, 2) @map("remaining_balance")
  paymentMethod        String               @db.VarChar(50) @map("payment_method")
  transactionReference String?              @db.VarChar(100) @map("transaction_reference")
  paymentDate          DateTime             @default(now()) @map("payment_date") @db.Timestamp(6)
  status               PaymentStatus        @default(PENDING)
  receptionistId       String               @db.Uuid @map("receptionist_id")
  remarks              String?              @db.Text
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamp(6)

  enrollment           Enrollment           @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  receptionist         User                 @relation("ReceptionistPayments", fields: [receptionistId], references: [id], onDelete: Restrict)
  approval             PaymentApproval?
  approvalLogs         PaymentApprovalLog[]

  @@index([status])
  @@map("payments")
}

model PaymentApproval {
  id               String        @id @default(uuid()) @db.Uuid
  paymentId        String        @unique @db.Uuid @map("payment_id")
  foundingMemberId String        @db.Uuid @map("founding_member_id")
  status           PaymentStatus
  rejectionReason  String?       @db.Text @map("rejection_reason")
  reviewedAt       DateTime      @default(now()) @map("reviewed_at") @db.Timestamp(6)

  payment          Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  foundingMember   User          @relation("FoundingMemberApprovals", fields: [foundingMemberId], references: [id], onDelete: Restrict)

  @@map("payment_approvals")
}

model PaymentApprovalLog {
  id              String        @id @default(uuid()) @db.Uuid
  paymentId       String        @db.Uuid @map("payment_id")
  actorId         String        @db.Uuid @map("actor_id")
  action          String        @db.VarChar(50)
  previousStatus  PaymentStatus @map("previous_status")
  newStatus       PaymentStatus @map("new_status")
  rejectionReason String?       @db.Text @map("rejection_reason")
  comments        String?       @db.Text
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamp(6)

  payment         Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  actor           User          @relation("ApprovalActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@map("payment_approval_logs")
}

model PaymentCard {
  id           String     @id @default(uuid()) @db.Uuid
  enrollmentId String     @db.Uuid @map("enrollment_id")
  qrToken      String     @unique @db.VarChar(255) @map("qr_token")
  cardNumber   String     @unique @db.VarChar(100) @map("card_number")
  issuedAt     DateTime   @default(now()) @map("issued_at") @db.Timestamp(6)
  status       CardStatus @default(ACTIVE)

  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  @@index([qrToken])
  @@map("payment_cards")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid @map("user_id")
  action    String   @db.VarChar(100)
  module    String   @db.VarChar(100)
  details   Json?
  ipAddress String?  @db.VarChar(45) @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user      User?    @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@index([module])
  @@index([createdAt])
  @@map("audit_logs")
}
