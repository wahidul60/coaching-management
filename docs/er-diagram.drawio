                <mxCell id="rel15" value="1 : 0..N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#191919;" parent="1" source="Enrollment" target="PaymentCard" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="DesignNotes" value="&lt;b&gt;DESIGN NOTES&lt;/b&gt;&lt;br&gt;1. Student.academic_batch_id = student's current batch.&lt;br&gt;2. Enrollment.academic_batch_id = batch at enrollment (historical snapshot).&lt;br&gt;3. PaymentApproval stores current/latest decision (one row per payment).&lt;br&gt;4. PaymentApprovalLog stores every submission, rejection, resubmission and approval event.&lt;br&gt;5. PaymentCard is an enrollment/course identity card, not a payment receipt. Issue after first approved payment; reissues create additional card records.&lt;br&gt;6. Keep financial receipts/payment history separate from the identity card." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;arcSize=0;fontColor=#191919;" parent="1" vertex="1">
